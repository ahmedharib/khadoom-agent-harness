# Commercial OpenAI Pair (LLM + text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------
# Local / Open-Weight Pair (e.g. Qwen 3 via Colab vLLM or Ollama)
# ------------------------------------------------------------------
# LLM_BASE_URL=https://your-colab-tunnel.trycloudflare.com/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=Qwen/Qwen3-8B-FP8
# LLM_DISABLE_THINKING=true
# LLM_HOURLY_COST_USD=0.25

# Local OpenAI-compatible Embeddings & Reranker Sidecar (Port 8001 in Colab)
# EMBEDDING_BASE_URL=https://your-colab-embed-tunnel.trycloudflare.com/v1
# EMBEDDING_API_KEY=not-needed
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# RERANKER_BASE_URL=https://your-colab-embed-tunnel.trycloudflare.com/v1
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------
# Commercial Reranker (Cohere - works with either Local or Commercial pair)
# ------------------------------------------------------------------
# COHERE_API_KEY=your_cohere_api_key_here
# COHERE_RERANK_MODEL=rerank-v3.5

# ------------------------------------------------------------------
# Vector Database (Option 1: Qdrant - run `docker compose up -d`)
# ------------------------------------------------------------------
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
