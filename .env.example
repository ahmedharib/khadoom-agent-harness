# Default OpenAI configuration
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------
# Optional: Open-Weight / Colab / Local Model Configuration (e.g. Qwen 3 via vLLM)
# ------------------------------------------------------------------
# LLM_BASE_URL=https://your-colab-tunnel.trycloudflare.com/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_DISABLE_THINKING=true
# LLM_HOURLY_COST_USD=0.25

# Optional: Dedicated OpenAI-compatible Embeddings endpoint (if not using OpenAI)
# EMBEDDING_BASE_URL=https://your-colab-embed-tunnel.trycloudflare.com/v1
# EMBEDDING_API_KEY=not-needed
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

